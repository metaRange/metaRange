+<span class="r-in"><span><span class="fu"><a href="https://rdrr.io/r/base/names.html" class="external-link">names</a></span><span class="op">(</span><span class="va">sim_env</span><span class="op">)</span> <span class="op">&lt;-</span> <span class="st">"env_01"</span></span></span>
