+<span>                <span class="co"># where should it be saved</span></span>
+<span>                path <span class="op">=</span> <span class="va">self</span><span class="op">$</span><span class="va">globals</span><span class="op">$</span><span class="va">save_dir</span></span>
+<span>            <span class="op">)</span></span>
+<span>            <span class="fu"><a href="https://rdrr.io/r/base/print.html" class="external-link">print</a></span><span class="op">(</span><span class="fu"><a href="https://rdrr.io/r/base/c.html" class="external-link">c</a></span><span class="op">(</span><span class="st">"saved: "</span>, <span class="fu"><a href="https://rdrr.io/r/base/basename.html" class="external-link">basename</a></span><span class="op">(</span><span class="va">result_paths</span><span class="op">)</span><span class="op">)</span><span class="op">)</span></span>
+<span>            <span class="va">self</span><span class="op">$</span><span class="va">globals</span><span class="op">$</span><span class="va">result_paths</span> <span class="op">&lt;-</span> <span class="fu"><a href="https://rdrr.io/r/base/c.html" class="external-link">c</a></span><span class="op">(</span></span>
+<span>                <span class="va">self</span><span class="op">$</span><span class="va">globals</span><span class="op">$</span><span class="va">result_paths</span>,</span>
+<span>                <span class="va">result_paths</span></span>
+<span>            <span class="op">)</span></span>
+<span>        <span class="op">}</span></span>
+<span>    <span class="op">}</span>,</span>
+<span>    execution_priority <span class="op">=</span> <span class="fl">2</span></span>
+<span><span class="op">)</span></span>
+<span></span>
+<span><span class="va">sim</span><span class="op">$</span><span class="fu">begin</span><span class="op">(</span><span class="op">)</span></span>
